# Copy this file to .env.local and fill in real values from
# Supabase Dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Used to build the email confirmation redirect link during sign-up.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service role key is SECRET. Only ever used in trusted server-only scripts
# (e.g. one-off admin/migration scripts run locally), NEVER in app code that
# ships to the client, and NEVER imported by anything under app/ that can
# execute in the browser. Leave unset unless a specific server-only task
# requires it.
# SUPABASE_SERVICE_ROLE_KEY=

# Shiprocket credentials are SECRET. Used only by lib/shiprocket/* (server
# only — never NEXT_PUBLIC_, never imported by a Client Component). See
# lib/shiprocket/env.ts.
# SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in/v1/external
# SHIPROCKET_API_EMAIL=
# SHIPROCKET_API_PASSWORD=
