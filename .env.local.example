# Copy this file to .env.local and fill in real values from
# Supabase Dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Used to build the email confirmation redirect link during sign-up.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service role key is SECRET. Used only in trusted server-only scripts
# (e.g. one-off admin/migration scripts run locally) and by the one
# narrow, justified exception at lib/supabase/service-role.ts (the
# Razorpay webhook route, app/api/webhooks/razorpay/route.ts — a
# signature-verified server-to-server call with no Supabase session to
# authorize against). NEVER imported by anything reachable from the
# browser. Leave unset unless a specific server-only task requires it.
# SUPABASE_SERVICE_ROLE_KEY=

# Shiprocket credentials are SECRET. Used only by lib/shiprocket/* (server
# only — never NEXT_PUBLIC_, never imported by a Client Component). See
# lib/shiprocket/env.ts.
# SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in/v1/external
# SHIPROCKET_API_EMAIL=
# SHIPROCKET_API_PASSWORD=

# Razorpay credentials are SECRET (KEY_SECRET and WEBHOOK_SECRET — never
# KEY_ID, which is also secret here but additionally returned to the
# customer's browser at payment time by
# app/checkout/razorpay-actions.ts, exactly as Razorpay Standard Checkout
# requires). Used only by lib/razorpay/* (server only) and the webhook
# route at app/api/webhooks/razorpay/route.ts. See lib/razorpay/env.ts.
# Test Mode credentials only for local/dev use — never live keys here.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
